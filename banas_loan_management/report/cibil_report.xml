<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="banas_loan_cibil_report" model="ir.actions.server">
            <field name="name">Cibil Report</field>
            <field name="state">code</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="binding_model_id" ref="model_res_partner"/>
            <field name="binding_view_types">list,form</field>
            <field name="code">
                if records:
                action = records.cibil_report()
            </field>
        </record>       
        <record id="view_banas_cibil_report_form" model="ir.ui.view">
        <field name="name">banas.cibil.report</field>
        <field name="model">banas.cibil.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="partner_id"/>
                </group>
                <group>
                </group>
                <footer>
                    <button string="Print Report" name="action_print_cibil_report" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_banas_cibil_report" model="ir.actions.act_window">
        <field name="name">Cibil Report</field>
        <field name="res_model">banas.cibil.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_banas_cibil_report_form" />
    </record>
    </data>
</odoo>
