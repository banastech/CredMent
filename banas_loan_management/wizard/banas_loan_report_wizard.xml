<?xml version="1.0"?>
<odoo>

    <record id="view_banas_loan_statement_wizard_form" model="ir.ui.view">
        <field name="name">banas.loan.statement.wizard.form</field>
        <field name="model">banas.loan.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="loan_ids" widget="many2many_tags"/>
                </group>
                <group>
                    <group>
                        <field name="type" invisible="1"/>
                        <field name="statement_type" attrs="{'invisible': [('type', '!=', 'statement')], 'required': [('type', '=', 'statement')]}"/>
                        <field name="date_start" attrs="{'required': [('statement_type', '=', 'date')], 'invisible': [('statement_type', '!=', 'date')]}"/>
                        <field name="date_end" attrs="{'required': [('statement_type', '=', 'date')], 'invisible': [('statement_type', '!=', 'date')]}"/>
                        <field name="installment_from" attrs="{'required': [('statement_type', '=', 'installment')], 'invisible': [('statement_type', '!=', 'installment')]}"/>
                        <field name="installment_to" attrs="{'required': [('statement_type', '=', 'installment')], 'invisible': [('statement_type', '!=', 'installment')]}"/>
                    </group>
                    <group>
                    </group>
                </group>
                <footer>
                    <button string="Print Statement" name="action_print_statement" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_banas_loan_statement_wizard" model="ir.actions.act_window">
        <field name="name">Loan Statement Wizard</field>
        <field name="res_model">banas.loan.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_banas_loan_statement_wizard_form" />
    </record>


</odoo>