        <record id="banas_loan_multi_company_rule" model="ir.rule">
            <field name="name">Banas loan multi-company</field>
            <field ref="model_banas_loan" name="model_id"/>
            <field eval="False" name="global"/>
            <field name="groups" eval="[(6, 0, [ref('base.group_user'), ref('base.group_portal'), ref('base.group_public')])]"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
        </record>

