        <record model="ir.module.category" id="module_category_banas_loan">
            <field name="name">Loan</field>
            <field name="description">Helps you handle your loan needs</field>
            <field name="sequence">7</field>
        </record>

        <record id="group_banas_loan_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_banas_loan"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_banas_loan_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="category_id" ref="module_category_banas_loan"/>
            <field name="implied_ids" eval="[(4, ref('banas_loan_management.group_banas_loan_user'))]"/>
        </record>

        <record id="group_banas_loan_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_banas_loan"/>
            <field name="implied_ids" eval="[(4, ref('banas_loan_management.group_banas_loan_officer'),ref('base.group_partner_manager'))]"/>


        </record>
        <record id="group_loan_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="module_category_banas_loan"/>
            <field name="implied_ids" eval="[(4, ref('banas_loan_management.group_banas_loan_manager'))]"/>
        </record>
        <record id="base.user_root" model="res.users">
           <field eval="[(4,ref('group_banas_loan_manager'))]" name="groups_id"/>         
        </record>

        <record id="base.user_admin" model="res.users">
           <field eval="[(4,ref('group_banas_loan_manager'))]" name="groups_id"/>
        </record>


