<odoo>
  
    <data noupdate="1">
        <!-- Automatic Add overdue followup -->
        <record id="ir_cron_add_followup_overdue" model="ir.cron">
            <field name="name">Add FollowUp of overdue</field>
            <field name="model_id" ref="banas_loan_management.model_account_loan_line"/>
            <field name="state">code</field>
            <field name="code">model.update_follow_up_ids()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
