<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="loan_customer_action" model="ir.ui.view">
        <field name="name">Customers</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_loan_count" icon="fa-book">
                    <field string="Loans" name="loan_count_num" widget="statinfo" modifiers="{&quot;readonly&quot;: true}"/>
                </button>
                <!-- <button class="oe_stat_button" type="object" name="action_loan_count" icon="fa-solid fa-ranking-star">
                    <field string="Credit Score" name="credit_score" widget="statinfo" modifiers="{&quot;readonly&quot;: true}"/>
                </button> -->
                <button class="oe_stat_button" type="object" name="archive_me" icon="fa-archive" invisible="active == False" style="color:green;">Archive</button>
                <button class="oe_stat_button" type="object" name="archive_me" icon="fa-archive" invisible="active == True" style="color:red;">Unarchive</button>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_create_loan" string="Create Loan" type="object" class="oe_highlight" />
                </header>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="create_date"/>
                <field name="write_date"/>
            </xpath>
            <!-- type field invisible from here -->
            <span class="o_form_label o_td_label" name="address_name" position= "replace">
                <span class="o_form_label o_td_label" name="address_name">
                    <field name= "type" invisible="1"/>
                    <b>Address</b>
                </span>
            </span>

            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page name="identities" string="Identities &amp; Documents">
                    <field name="document_ids" mode="kanban"/>
                </page>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

             <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="placeholder">e.g. https://www.banastech.com</attribute>
            </xpath>
            <xpath expr="//field[@name='title']" position='after'>
                <field name="gender" invisible="company_type != 'person'"/>
                <field name = "marital_status" invisible="company_type != 'person'"/>
            </xpath>
            <xpath  expr="//div[hasclass('o_address_format')]" position="after">
                <field name="partner_type" groups="base.group_no_one"  />
                <field name="type" groups="base.group_no_one" invisible="1" />
                <field name="pan_number" invisible="company_type != 'person'" placeholder="ABCTY1234D"/>
                <field name="date_of_birth" 
                        invisible="company_type != 'person'" />
                <!-- <field name="branch_ids" widget="many2many_tags" options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}"/> -->
                <field name="date_of_registration" string="Registration Date" invisible="company_type == 'person'"/>
                <field name="cibil_score" string="Cibil Score"/>
            </xpath>

            <xpath expr="//sheet//notebook//page[@name='contact_addresses']" position="replace">
                <page string="Contacts &amp; Addresses" name="contact_addresses" autofocus="autofocus">
                    <field name="child_ids" mode="kanban" context="{'default_parent_id': active_id, 'default_street': street, 'default_street2': street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip, 'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id, 'default_type': 'other'}">
                        <kanban>
                            <field name="id"/>
                            <field name="color"/>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="type"/>
                            <field name="email"/>
                            <field name="parent_id"/>
                            <field name="is_company"/>
                            <field name="function"/>
                            <field name="phone"/>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="zip"/>
                            <field name="relationship_id"/>
                            <field name="city"/>
                            <field name="country_id"/>
                            <field name="mobile"/>
                            <field name="state_id"/>
                            <field name="image_128"/>
                            <field name="avatar_128"/>
                            <field name="lang"/>
                            <field name="comment"/>
                            <field name="display_name"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <t t-set="color" t-value="kanban_color(record.color.raw_value)"/>
                                    <div t-att-class="color + (record.title.raw_value == 1 ? ' oe_kanban_color_alert' : '') + ' oe_kanban_global_click'">
                                        <div class="row">
                                            <div class="offset-10">
                                                <div class="o_dropdown_kanban dropdown" groups="base.group_user">
                                                    <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                                        <span class="fa fa-ellipsis-v"/>
                                                    </a>
                                                    <div class="dropdown-menu" role="menu">
                                                        <a t-attf-href="/web/content/ir.attachment/#{record.id.raw_value}/datas?download=true" download="" class="dropdown-item">Download</a>
                                                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="o_kanban_image">
                                            <img alt="Contact image" t-att-src="kanban_image('res.partner', 'avatar_128', record.id.raw_value)"/>
                                        </div>
                                        <div class="oe_kanban_details">
                                            <div t-if="record.function.raw_value"><field name="function"/></div>
                                            <div t-if="record.name.raw_value">
                                                Name:
                                                <field name="name"/>
                                            </div>
                                            <div t-if="record.email.raw_value">Email: <field name="email" widget='email'/></div>
                                            <div t-if="record.type.raw_value != 'contact'">
                                                <div>
                                                    <field name="zip"/><t t-if="record.city"> </t>
                                                    <field name="city"/>
                                                </div>
                                                <field t-if="record.state_id.raw_value" name="state_id"/><t t-if="record.country_id"> </t>
                                                <field name="country_id"/>
                                            </div>
                                            <div t-if="record.phone.raw_value">Relationship: <t t-esc="record.relationship_id.value"/></div>
                                            <div t-if="record.mobile.raw_value">Mobile: <t t-esc="record.mobile.value"/></div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <form string="Contact / Address">
                            <sheet>
                                <field name="type" required="1" widget="radio" options="{'horizontal': true}" invisible="1"/>
                                <field name="individual_type" required="1" widget="radio" options="{'horizontal': true}"/>
                                <!-- <field name="child_company_type" required="1" widget="radio" options="{'horizontal': true}" attrs="{'invisible': [('parent_company_type', '=', 'person')]}"/> -->
                                <field name="parent_id" invisible="1"/>
                                <hr/>
                                <group>
                                    <group>
                                        <!-- <field name="parent_company_type" invisible="1" widget="radio" options="{'horizontal': true}"/> -->
                                        <field name="name" string="Name" invisible="1" class="oe_read_only_no_invisible"/>
                                        <field name="first_name" required="1" placeholder="First Name" force_save="1" />
                                        <field name="middle_name"  placeholder="Middle Name"/>
                                        <field name="last_name"  required="1" placeholder="Last Name"/>
                                        <field name="title" placeholder="e.g. Mr."/>
                                        <field name="function" placeholder="e.g. Sales Director"/>
                                        <field name="date_of_birth"/>
                                        <field name="gender"/>
                                        <field name="marital_status"/>
                                        <field name="relationship_id" required="individual_type == 'family'" invisible="individual_type != 'family'"/>
                                        <field name="email"/>
                                        <field name="phone" widget="phone"/>
                                        <field name="mobile" widget="phone"/>
                                        <field name="comment" placeholder="Qualification, Work, About etc."/>

                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>

            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="string">Bank Accounts </attribute>
            </xpath>
            <group name="accounting_entries" position='replace'>
                <group string="Accounting Entries" name="accounting_entries" groups="account.group_account_readonly" invisible="1">
                    <field name="currency_id" invisible="1"/>
                    <field name="property_account_receivable_id"/>
                    <field name="property_account_payable_id"/>
                </group>
            </group >
            <xpath expr="//page[@name='accounting']" position="after">
                <page string ="Others">
                    <group >
                        <group>
                            <field name="ref"/>
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" placeholder="Tags..."/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date_approved"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!-- <xpath expr="//button[@name='action_view_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->

            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_partner_rto_form" model="ir.actions.act_window">
        <field name="name">RTO Offices</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_rto':1,'default_partner_type':'rto_office'}</field>
        <field name="filter" eval="True"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new RTO in your address book
            </p>
            <p></p>
        </field>
    </record>
    <record id="action_partner_vendor_form" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_vendors':1,'default_partner_type':'vendor'}</field>
        <field name="filter" eval="True"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Vendor in your address book
            </p>
            <p></p>
        </field>
    </record>
    <record id="view_banas_loan_partner_filter" model="ir.ui.view">
        <field name="name">banas.loan.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="type_person" position="after">
                <filter name="vendors" string="Vendors" domain="[('partner_type', '=', 'vendor')]"/>
                <filter name="rto" string="RTO Office" domain="[('partner_type', '=', 'rto_office')]"/>
            </filter>
            <filter name="customer" position="attributes">
                <attribute name="string">Customer</attribute>
            </filter>
        </field>
    </record>
    <record id="action_banas_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{"search_default_customer":1, "default_partner_type": 'customer'}</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('base.res_partner_kanban_view')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('base.view_partner_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('banas_loan_management.loan_customer_action')})]"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new customer in your address book
            </p><p>
            System helps you easily track all activities related to a customer.
        </p>
    </field>
</record>

<menuitem
    id="base.res_partner_menu_customer"
    name="Customers"
    parent="menu_account_loan_root"
    action="action_banas_customer"
    sequence="4"/>

    <record id="view_banas_res_relationship_tree" model="ir.ui.view">
        <field name="name">res.relationship.tree</field>
        <field name="model">res.relationship</field>
        <field name="arch" type="xml">
            <tree string="Relationship" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_banas_res_relationship_form" model="ir.ui.view">
        <field name="name">res.relationship.form</field>
        <field name="model">res.relationship</field>
        <field name="arch" type="xml">
            <form string="Relationship">
                <group>
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active"/>
                </group>
            </form>
        </field>
    </record>
    <record id="action_banas_res_relationship" model="ir.actions.act_window">
        <field name="name">Relationship</field>
        <field name="res_model">res.relationship</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
