<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="banas_installment_tree" model="ir.ui.view">
            <field name = "name">banas.installment.tree</field>
            <field name = "model">account.loan.line</field>
            <field name = "arch" type = "xml">
                <tree>        
                    <field name="loan_id"/>
                    <field name="partner_id"/>
                    <field name="type"/>
                    <field name="rate"/>
                    <field name="instl_no" groups="base.group_no_one"/>
                    <field name="advance_no" groups="base.group_no_one"/>
                    <field name="seq_name"/>
                    <field name="date"/>
                    <field name="pending_principal_amount"/>
                    <field name="payment_amount" sum="Total payments"/>
                    <field name="principal_amount"/>
                    <field name="interests_amount" sum="Total interests"/>
                    <field name="loan_state" invisible="1"/>
                    <field name="is_leasing" invisible="1"/>
                    <field name="has_invoices" invisible="1"/>
                    <field name="has_moves" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="state"/>
                    <field name="has_payments" invisible="1"/>
                        <button name="view_account_values" string="Entires"
                            type="object" icon="fa-book"
                            invisible="state != 'done'"/>
                            <button name="view_process_values" string="Payment"
                                type="object" icon=""
                                invisible="state == 'done' or state == 'cancelled'"/>
                        </tree>
                    </field>
                </record>
        <record id="account_loan_line_form" model="ir.ui.view">
            <field name="name">banas.installment.form</field>
            <field name="model">account.loan.line</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="view_account_values" string="Entries" type="object" icon="fa-book" invisible="state != 'done'" groups="banas_loan_management.group_banas_loan_officer,banas_loan_management.group_banas_loan_manager"/>
                        <button name="view_process_values" string="Payment" type="object" icon="" invisible="loan_state != 'posted' or state == 'done'" groups="banas_loan_management.group_banas_loan_officer,banas_loan_management.group_banas_loan_manager"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="seq_name"/>
                                <field name="type" groups="base.group_no_one"/>
                                <field name="sequence" groups="base.group_no_one"/>
                                <field name="rate"/>
                                <field name="date"/>
                                <field name="has_moves" invisible="1"/>
                                <field name="has_payments" invisible="1"/>
                                <field name="loan_state" invisible="1"/>
                                <!-- <field name="followup_line" readonly="1"/> -->
                            </group>
                            <group>
                                <field name="pending_principal_amount"/>
                                <field name="payment_amount"/>
                                <field name="principal_amount"/>
                                <field name="interests_amount"/>
                                <field name="final_pending_principal_amount"/>
                            </group>
                        </group>
                        <!-- <group string="SMS" groups="base.group_no_one">
                            <group>
                                <field name="sms_upcomming"/>
                                <field name="sms_payment"/>
                                <field name="sms_due_payment1"/>
                                <field name="sms_due_payment2"/>
                            </group>
                            <group>
                            </group>
                        </group> -->
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="banas_installment_graph" model="ir.ui.view">
            <field name="name">banas.installment.graph</field>
            <field name="model">account.loan.line</field>
            <field name="arch" type="xml">
                <graph>
                    <field name="state" type="bar" string="Installment State" />
                    <field name="seq_name"/>
                    <field name="rate"/>
                    <field name="date"/>
                    <field name="payment_amount"/>

                </graph>
            </field>
        </record>
        <record id="account_banas_loan_installments_search" model="ir.ui.view">
            <field name="name">banas.installment.search</field>
            <field name="model">account.loan.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="loan_id"/>
                    <separator/>
                    <filter name="today" string="Today Payments" domain="[('installment_invoice_date', '=', time.strftime('%%Y-%%m-%%d')),
                    ('installment_payment_state', '=', 'not_paid')]" help="Overdue Installments, maturity date passed"/>
                    <filter name="upcoming" string="    " domain="[('installment_invoice_date', '>', context_today()),('installment_payment_state', '=', 'not_paid')]" 
                    help="Overdue Installments, maturity date passed"/>
                    <filter name="late" string="Overdue" domain="[ ('installment_invoice_date', '&lt;', time.strftime('%%Y-%%m-%%d')),
                    ('installment_payment_state', '=', 'not_paid')]" 
                    help="Overdue"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_loan_id" string="Loans" context="{'group_by':'loan_id'}"/>
                        <filter name="group_by_partner_id" string="Customers" context="{'group_by':'partner_id'}"/>
                        <!-- <filter name="group_by_followup_line" string="Overdue Days" context="{'group_by':'followup_line'}"/> -->
                    </group>
                </search>
            </field>
        </record>
        <record id="banas_loan_installment_action" model="ir.actions.act_window">
            <field name="name">Installments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.loan.line</field>
            <field name="view_mode">tree,form,pivot,graph,activity,kanban</field>
            <field name="target">current</field>
            <field name="context">{'search_default_today': 1, 'search_default_group_by_loan_id': 1}</field>
        </record>

        <menuitem id="menu_banas_loan_installment"
            name="Installments" 
            action="banas_loan_installment_action" 
            parent="menu_account_loan_root" 
            sequence="15"/> 
    </data>
</odoo>