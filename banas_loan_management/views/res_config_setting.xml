<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>        
        <record id="res_config_settings_view_loan_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.loan</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <div class="app_settings_block" data-string="Loan" string="Loan" data-key="banas_loan_management" groups="base.group_system">
                        <h2>Journals</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Journals</span>
                                    <span class="fa fa-lg fa-book" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                                    <div class="text-muted">
                                        Banas Loan Journals
                                    </div>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="journal_processing_fee_id" class="col-lg-5 o_light_label"/>
                                            <field name="journal_processing_fee_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                                        </div>
                                        <div class="row mt16">
                                            <label for="journal_loan_id" class="col-lg-5 o_light_label"></label>
                                            <field name="journal_loan_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}" class="col-lg-8"/>
                                        </div>
                                        <div class="row mt16">
                                            <label for="journal_other_fee_id" class="col-lg-5 o_light_label"></label>
                                            <field name="journal_other_fee_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}" class="col-lg-8"/>
                                        </div>
                                        <div class="row mt16">
                                            <label for="journal_debit_id" class="col-lg-5 o_light_label"></label>
                                            <field name="journal_debit_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}" class="col-lg-8"/>
                                        </div>
                                        <div class="row mt16">
                                            <label for="sales_expense_journal_id" class="col-lg-5 o_light_label"></label>
                                            <field name="sales_expense_journal_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}" class="col-lg-8"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <h2>Accounts</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Accounts</span>
                                    <span class="fa fa-lg fa-university" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                                    <div class="text-muted">
                                        Banas Loan Accounts
                                    </div>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="interest_revenue_account_id" class="col-lg-3 o_light_label"/>
                                            <field name="interest_revenue_account_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                                        </div>
                                        <div class="row mt16">
                                            <label for="transfer_account_id" class="col-lg-3 o_light_label"/>
                                            <field name="transfer_account_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                                        </div>
                                        <div class="row mt16">
                                            <label for="penalty_account_id" class="col-lg-3 o_light_label"/>
                                            <field name="penalty_account_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                        <h2>Products</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"></div>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Products</span>
                                    <span class="fa fa-lg fa-shopping-cart" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"></span>
                                    <div class="text-muted">
                                        Banas Loan Products
                                    </div>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="product_process_fee_id" class="col-lg-3 o_light_label"></label>
                                            <field name="product_process_fee_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}" class="col-lg-8"/>
                                        </div>
                                        <div class="row mt16">
                                            <label for="product_other_fee_id" class="col-lg-3 o_light_label"></label>
                                            <field name="product_other_fee_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}" class="col-lg-8"/>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-20 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"></div>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label"></span>
                                    <span class="" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"></span>
                                    <div class="text-muted">
                                        
                                    </div>
                                    <div class="content-group row mt16">
                                        <div class="row mt16">
                                            <label for="product_sales_person_id" class="col-lg-4 o_light_label"></label>
                                            <field name="product_sales_person_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}" class="col-lg-8"/>
                                        </div>
                                        <div class="row mt16">
                                            <label for="product_debit_note_id" class="col-lg-3 o_light_label"></label>
                                            <field name="product_debit_note_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}" class="col-lg-8"/>
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                        <h2>Sequence</h2>
                        <div class="row mt16 o_settings_container" id="loan_change">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Sequence</span>
                                    <span class="fa fa-lg fa-exchange" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                                    <div class="text-muted">
                                        Banas App Sequence
                                    </div>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="application_seq_id" class="col-lg-3 o_light_label"/>
                                            <field name="application_seq_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-20 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"></div>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Sequence</span>
                                    <span class="fa fa-lg fa-exchange" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"></span>
                                    <div class="text-muted">
                                        Banas Loan Sequence
                                    </div>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="loan_seq_id" class="col-lg-3 o_light_label"></label>
                                            <field name="loan_seq_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}" class="col-lg-8"/>
                                        </div>
                                       
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
        <record id="action_loan_configuration" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'banas_loan_management', 'bin_size': False}</field>
        </record>


    </data>
</odoo>