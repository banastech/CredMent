<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_banas_loan_doc_type_tree" model="ir.ui.view">
        <field name="name">banas.loan.doc.type.tree</field>
        <field name="model">banas.loan.document.type</field>
        <field name="arch" type="xml">
            <tree string="Loan Document Type" editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="view_banas_loan_doc_type_form" model="ir.ui.view">
        <field name="name">banas.loan.doc.type.form</field>
        <field name="model">banas.loan.document.type</field>
        <field name="arch" type="xml">
            <form string="Loan Document Type">
                <group>
                    <field name="name"/>
                    <field name="code"/>
                </group>
            </form>
        </field>
    </record>
    <record id="action_banas_loan_doc_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">banas.loan.document.type</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="view_banas_loan_doc_tree" model="ir.ui.view">
        <field name="name">banas.loan.doc.tree</field>
        <field name="model">banas.loan.document</field>
        <field name="arch" type="xml">
            <tree string="Loan Documents">
                <field name="name"/>
                <field name="type_id"/>
            </tree>
        </field>
    </record>

    <record id="view_banas_loan_document_form" model="ir.ui.view">
        <field name="name">banas.loan.document.form</field>
        <field name="model">banas.loan.document</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="type_id"/>
                <field name="loan_id" invisible="1"/>
            </field>
            <xpath expr="//field[@name='mimetype']" position="after">
              <field name="priority" widget="priority"/>
            </xpath>
        </field>
    </record>
    <record id="action_banas_loan_doc" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">banas.loan.document</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <record id="view_banas_partner_document_kanban" model="ir.ui.view">
        <field name="name">banas.partner.document.kanban</field>
        <field name="model">banas.partner.document</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="ir_attachment_id"/>
                <field name="mimetype"/>
                <field name="type"/>
                <!-- <field name="datas_fname"/> -->
                <field name="name"/>
                <field name="priority"/>
                <field name="create_uid"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_area o_kanban_attachment oe_kanban_global_click">
                            <div class="row">
                                <div class="offset-10">
                                    <div class="o_dropdown_kanban dropdown" groups="base.group_user">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-attf-href="/web/content/ir.attachment/#{record.ir_attachment_id.raw_value}/datas?download=true" download="" class="dropdown-item">Download</a>
                                            <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                        </div>
                                    </div>
                                </div>
                                </div>
                            <div class="o_kanban_image">
                                    <div class="o_kanban_image_wrapper">
                                        <t t-set="webimage" t-value="new RegExp('image.*(gif|jpeg|jpg|png)').test(record.mimetype.value)"/>
                                        <div t-if="record.type.raw_value == 'url'" class="o_url_image fa fa-link fa-3x text-muted" aria-label="Image is a link"/>
                                        <img t-elif="webimage" t-attf-src="/web/image/#{record.ir_attachment_id.raw_value}" width="100" height="100" alt="Document" class="o_attachment_image"/>
                                        <div t-else="!webimage" class="o_image o_image_thumbnail" t-att-data-mimetype="record.mimetype.value"/>
                                    </div>
                                </div>
                            <div class="o_kanban_details">
                                <div class="o_kanban_details_wrapper">
                                    <div class="o_kanban_record_title">
                                        <field name="type_id" class="o_text_overflow"/>
                                        <br/>
                                        <field name="name" class="o_text_overflow"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                      <!-- <field name="datas_fname" attrs="{'invisible':[('type','=','url')]}"/> -->
                                      <field name="url" widget="url" attrs="{'invisible':[('type','=','binary')]}"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <span class="oe_kanban_bottom_left">
                                            <field name="priority" widget="priority"/>
                                        </span>
                                        <div class="oe_kanban_bottom_right">
                                                <field name="create_uid" widget="many2one_avatar_user"/>
                                            </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_banas_loan_document_kanban" model="ir.ui.view">
        <field name="name">banas.loan.document.kanban</field>
        <field name="model">banas.loan.document</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="ir_attachment_id"/>
                <field name="mimetype"/>
                <field name="type"/>
                <!-- <field name="datas_fname"/> -->
                <field name="name"/>
                <field name="priority"/>
                <field name="create_uid"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_area o_kanban_attachment oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <div class="o_kanban_image_wrapper">
                                    <t t-set="webimage" t-value="new RegExp('image.*(gif|jpeg|jpg|png)').test(record.mimetype.value)"/>
                                    <div t-if="record.type.raw_value == 'url'" class="o_url_image fa fa-link fa-3x text-muted"/>
                                    <img t-elif="webimage" t-attf-src="/web/image/#{record.ir_attachment_id.raw_value}?field=thumbnail" width="100" height="100" alt="Document" class="o_attachment_image"/>
                                    <div t-else="!webimage" class="o_image o_image_thumbnail" t-att-data-mimetype="record.mimetype.value"/>
                                </div>
                            </div>
                            <div class="o_kanban_details">
                                <div class="o_kanban_details_wrapper">
                                    <div class="o_kanban_record_title">
                                        <field name="name" class="o_text_overflow"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                      <!-- <field name="datas_fname" attrs="{'invisible':[('type','=','url')]}"/> -->
                                      <field name="url" widget="url" attrs="{'invisible':[('type','=','binary')]}"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <span class="oe_kanban_bottom_left">
                                            <field name="priority" widget="priority"/>
                                        </span>
                                        <div class="oe_kanban_bottom_right">
                                            <img t-att-src="kanban_image('res.users', 'image_small', record.create_uid.raw_value)" t-att-data-member_id="record.create_uid.raw_value" t-att-alt="record.create_uid.raw_value" width="32" height="32" class="oe_kanban_avatar"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_banas_partner_doc_tree" model="ir.ui.view">
        <field name="name">banas.partner.document.tree</field>
        <field name="model">banas.partner.document</field>
        <field name="arch" type="xml">
            <tree string="Loan Documents">
                <field name="name"/>
                <field name="type_id"/>
            </tree>
        </field>
    </record>

    <record id="view_banas_partner_document_form" model="ir.ui.view">
        <field name="name">banas.partner.document.form</field>
        <field name="model">banas.partner.document</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <label for="name" position="replace"/>
            <h1 position="replace"/>
            <field name="type" position="after">
                <field name="type_id" options="{'no_create_edit': 1}"/>
                <field name="name" string="Ref"/>
            </field>
            <xpath expr="//field[@name='mimetype']" position="after">
              <field name="priority" widget="priority"/>
            </xpath>
        </field>
    </record>
    <record id="action_banas_partner_doc" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">banas.partner.document</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
   
</odoo>
